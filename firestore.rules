rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Public read and admin-managed collections
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /advertisements/{adId} {
      allow read: if true;
      allow update: if isAuthenticated() || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'clicksCount', 'impressions', 'impressionsCount', 'lastClickedAt', 'updatedAt']);
      allow create, delete: if isAuthenticated();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // Customer orders
    match /orders/{orderId} {
      // Anyone can create an order (even guest / new customers)
      allow create: if true;
      // Read allowed if matches customerId, customerPhone, or authenticated admin
      allow read: if true;
      // Update/status change allowed for admin or authenticated staff
      allow update, delete: if isAuthenticated();
    }

    // Support chat
    match /conversations/{conversationId} {
      allow read, write: if true;
    }

    match /conversations/{conversationId}/messages/{messageId} {
      allow read, write: if true;
    }

    // Direct flat messages collection
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
